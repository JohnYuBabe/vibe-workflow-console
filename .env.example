# ---------- MySQL (docker compose) ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=vibe_console
MYSQL_USER=vibe
MYSQL_PASSWORD=vibe

# Host-side connection. Compose maps MySQL to 3308 to avoid clashing with local 3306/3307.
DATABASE_URL="mysql://vibe:vibe@localhost:3308/vibe_console"

# ---------- Server ----------
# Local dev port. 3000 is often taken by other projects on this machine.
PORT=3010
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# ---------- Web ----------
VITE_API_BASE=/api
VITE_BASE=/
