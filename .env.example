# 复制为 .env 后使用。所有 CHANGE_ME_* 都必须替换，生产环境缺项会直接启动失败。
# 生成口令：openssl rand -base64 32

# ---------- MySQL (docker compose) ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MYSQL_DATABASE=vibe_console
MYSQL_USER=vibe
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP

# 宿主机直连（compose 把 3306 只映射到 127.0.0.1:3308）
DATABASE_URL="mysql://vibe:CHANGE_ME_MYSQL_APP@localhost:3308/vibe_console"

# ---------- Server ----------
# 本地开发端口（生产容器内部固定 3000，由 compose 映射到 127.0.0.1:3010）
PORT=3010
# 生产要求 >= 32 位且不含 change-me/dev-secret/example/test-secret 等字样
JWT_SECRET=CHANGE_ME_32_BYTES_OR_LONGER
JWT_EXPIRES_IN=12h
# 生产留空（同源经 nginx 转发，无需 CORS）；多域名用逗号分隔
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120

# ---------- Demo seed ----------
# 生产默认两种情况都为 false：不写演示数据。
# 需要重建演示库时，把两项同时设为 true 再重启 server。
SEED_ON_START=false
ALLOW_DEMO_SEED=false

# 生产 seed 必填：admin 至少 16 位，demo 至少 12 位
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_16_CHARS_MIN
DEMO_EMAIL=demo@vibe.local
DEMO_PASSWORD=CHANGE_ME_DEMO_12_CHARS_MIN

# ---------- Web ----------
# 子路径部署：VITE_BASE=/console/、VITE_API_BASE=/console/api
VITE_BASE=/
VITE_API_BASE=/api
# 线上只有填写后才会在登录页显示 demo 账号；VITE_DEMO_* 会被打进 bundle，
# 因此只放可公开的 demo 账号，绝不能填 admin。
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
